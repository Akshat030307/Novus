# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.

# Step 14 — Supabase (cloud save). Leave empty to save to the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Step 15 — AI wording. Leave VITE_AI_ENABLED=false to play on the written
# fallback text (nothing breaks, it just reads a shade flatter).
# A key here ships in the client bundle: fine for local play with your own key,
# but a deploy must point VITE_AI_BASE_URL at a proxy that holds the key
# server-side (e.g. a Supabase Edge Function). Any OpenAI-compatible
# /chat/completions endpoint works.
VITE_AI_ENABLED=false
VITE_AI_BASE_URL=
VITE_AI_KEY=
VITE_AI_MODEL=gpt-4o-mini
