# Copy to .env and fill in for step 14 (Supabase).
# Until then the game saves to the browser and these can stay empty.
# Vite only exposes vars prefixed with VITE_ to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave empty to play with written fallback text instead of AI wording.
VITE_AI_ENABLED=false
